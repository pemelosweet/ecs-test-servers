# Parse Server 配置
PARSE_APP_ID=com.xmg.admin
PARSE_MASTER_KEY=your-master-key-here
PARSE_SERVER_URL=http://localhost:1337/parse

# MongoDB 连接
DATABASE_URI=mongodb://localhost:27017/ecs

# Dashboard 配置（Dashboard 与主服务同端口，路径 /dashboard）
PARSE_DASHBOARD_USER=admin
PARSE_DASHBOARD_PASSWORD=admin123

# 对外访问地址（文件/头像 URL 前缀，生产环境改成 https 域名）
PUBLIC_SERVER_URL=http://localhost:1337/parse

# 阿里云 OSS 文件存储（配置 OSS_BUCKET_NAME 后启用，否则回退 MongoDB GridFS）
OSS_BUCKET_NAME=your-bucket-name
OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 可选：自定义 OSS 端点（默认按 OSS_REGION 拼接 S3 兼容端点）
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# 阿里云号码认证服务（短信验证码，注册必填；未配置时 smsSend 报“短信服务未配置”）
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret
# 号码认证控制台“赠送签名/赠送模板”页面选择的签名与模板 CODE
SMS_SIGN_NAME=your-sign-name
SMS_TEMPLATE_CODE=100001
# 可选：方案名称（不填为“默认方案”，发送与校验必须一致）
# SMS_SCHEME_NAME=注册

# 阿里云图形认证（号码认证服务-图形认证方案管理控制台获取 appId/appKey）
GRAPHIC_CAPTCHA_APP_ID=your-app-id
GRAPHIC_CAPTCHA_APP_KEY=your-app-key

# Parse Dashboard 登录
PARSE_DASHBOARD_USER=xxx
PARSE_DASHBOARD_PASSWORD=xxx
# 服务端口
PORT=1337
