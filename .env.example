# =====================================================================
# 配置分层说明：
#   - 本文件只列「密钥 + 环境相关」项（真正需要环境注入的）
#   - 非密钥逻辑配置已在 config.js 给默认值，无需在此配置；如需覆盖，用同名环境变量：
#     PARSE_APP_ID(=xmg) / PORT(=1337) / PARSE_DASHBOARD_USER(=xmg001)
#     DATABASE_URI(=mongodb://127.0.0.1:27017/ecs，本机 MongoDB；迁独立库/云库时才需覆盖)
#     OSS_BUCKET_NAME(=xiaomge-1) / OSS_REGION(=cn-beijing) / OSS_ENDPOINT(=oss-cn-beijing.aliyuncs.com) / OSS_DIRECT_ACCESS(=false)
#     SMS_SIGN_NAME(=恒创联众) / SMS_TEMPLATE_CODE(=100001) / SMS_SCHEME_NAME(=空)
#     GRAPHIC_CAPTCHA_APP_ID(=非机密，默认已写) / GRAPHIC_CAPTCHA_ENABLED(=false)
#     ADMIN_INIT_USERNAME(=xmg001)
# =====================================================================

# ---------- Parse Server ----------
# 核心密钥（生产务必用 openssl rand -hex 32 生成，勿用示例值）
PARSE_MASTER_KEY=your-master-key-here

# ---------- Parse Dashboard ----------
# 密码（用户名默认 xmg001，见 config.js）
PARSE_DASHBOARD_PASSWORD=your-dashboard-password

# ---------- 阿里云 OSS（文件存储） ----------
# 密钥（bucket/region/endpoint 默认值见 config.js）
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 可选：自定义图床对外域名（生产建议绑定，否则回退 OSS 原生域名）
# OSS_PUBLIC_URL=https://img.xmg111.xyz

# ---------- 阿里云短信（号码认证） ----------
# 密钥（签名/模板 code 默认值见 config.js）
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# ---------- 阿里云图形认证 ----------
# 密钥（appId 非机密，默认值见 config.js）
GRAPHIC_CAPTCHA_APP_KEY=your-app-key

# ---------- 初始管理员（可选） ----------
# 默认用户名 xmg001 / 密码 admin123456（见 config.js），生产务必覆盖密码
# ADMIN_INIT_USERNAME=xmg001
# ADMIN_INIT_PASSWORD=your-strong-password
